# Copy to .env.local for local dev. In Vercel, set this in the
# Environment Variables dashboard instead — never commit real values.

NEXT_PUBLIC_API_URL=https://herald-backend-vlxv.onrender.com

# Optional — only add if you want Google Analytics active
NEXT_PUBLIC_GA_ID=

# Optional — enables the /search page. Create a free Google Programmable
# Search Engine at programmablesearchengine.google.com, scope it to your
# domain, and paste its Search Engine ID (the "cx" value) here.
NEXT_PUBLIC_GOOGLE_CSE_ID=
